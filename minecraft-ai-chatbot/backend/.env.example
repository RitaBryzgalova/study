# Шаблон переменных окружения
# Скопируйте в .env и заполните своими значениями

# Яндекс API
YANDEX_API_KEY=your_api_key_here
YANDEX_API_URL=https://llm.api.yandex.cloud/foundationModels/v1/completionStream
YANDEX_CATALOG_ID=your_catalog_id

# Сервер
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=8080
LOG_LEVEL=INFO

# Minecraft сервер
MINECRAFT_SERVER_HOST=localhost
MINECRAFT_SERVER_PORT=25565

# Модели
MODEL_NAME=yandexgpt-lite
MAX_TOKENS=500
TEMPERATURE=0.7
